{
  "id": "./",
  "name": "SQL-Optima Studio — SCADA Query Profiler",
  "short_name": "SQL-Optima",
  "description": "Offline-first query profiler, performance tuning hub and script workbench for SCADA historian engineers.",
  "lang": "en",
