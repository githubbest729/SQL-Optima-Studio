      "url": "./#/profiler",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Script Workbench",
      "short_name": "Scripts",
      "description": "Edit InTouch, C# and SQL scripts",
      "url": "./#/workbench",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "BOM & Costing",
      "short_name": "BOM",
      "description": "Project cost calculator",
      "url": "./#/bom",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "QHSE Checklist",
      "short_name": "QHSE",
      "description": "Compliance checklist",
      "url": "./#/qhse",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
